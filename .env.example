# Conexão PostgreSQL (Neon / Vercel Postgres). Use a URL com pooling em DATABASE_URL
# e a conexão direta (sem pooler) em DIRECT_URL — usada pelas migrações.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chibata?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/chibata?schema=public"

# URL pública do app (usada nos links mágicos e nos e-mails de lembrete)
APP_URL="http://localhost:3000"

# Segredo usado para proteger o endpoint de cron (a Vercel envia "Authorization: Bearer $CRON_SECRET")
CRON_SECRET="troque-por-um-valor-aleatorio-longo"

# Envio de e-mail (opcional) via Resend — necessário para link mágico e lembretes.
# Sem estas variáveis, os links mágicos são exibidos no log do servidor (apenas em desenvolvimento).
RESEND_API_KEY=""
EMAIL_FROM="ArqueaTec Desempenho <nao-responda@seudominio.com.br>"

# Fuso horário usado para definir "hoje" e dias úteis
APP_TIMEZONE="America/Sao_Paulo"

# Senha inicial dos usuários de demonstração criados pelo seed
SEED_PASSWORD="arqueatec123"
