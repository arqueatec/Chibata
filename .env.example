# Conexão PostgreSQL (Neon / Vercel Postgres). Use a URL com pooling em DATABASE_URL
# e a conexão direta (sem pooler) em DATABASE_URL_UNPOOLED — usada pelas migrações.
# A integração Neon da Vercel cria as duas automaticamente com esses nomes.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chibata?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/chibata?schema=public"

# URL pública do app (usada nos links mágicos e nos e-mails de lembrete)
APP_URL="http://localhost:3000"

# Segredo usado para proteger o endpoint de cron (a Vercel envia "Authorization: Bearer $CRON_SECRET")
CRON_SECRET="troque-por-um-valor-aleatorio-longo"

# Envio de e-mail (opcional) via Resend — necessário para link mágico e lembretes.
# Sem estas variáveis, os links mágicos são exibidos no log do servidor (apenas em desenvolvimento).
RESEND_API_KEY=""
EMAIL_FROM="ArqueaTec Desempenho <nao-responda@seudominio.com.br>"

# Fuso horário usado para definir "hoje" e dias úteis
APP_TIMEZONE="America/Sao_Paulo"

# Senha inicial dos usuários de demonstração criados pelo seed
SEED_PASSWORD="arqueatec123"

# Integração com o Asana (opcional): token pessoal de uma conta que veja todos os projetos da equipe.
# Gere em Asana → Configurações → Apps → Console do desenvolvedor → Criar novo token.
ASANA_TOKEN=""

# Integração com o CRM NoFire (opcional, somente leitura).
# CRM_API_URL: endereço do CRM (ex.: https://crm-no-fire-crm-no-fire.vercel.app)
# CRM_API_TOKEN: o mesmo valor configurado no CRM como CHIBATA_API_TOKEN
# CRM_BYPASS_SECRET: segredo de "Protection Bypass for Automation" do projeto do CRM na Vercel,
#   necessário se o CRM estiver com a proteção de deploy (Vercel Authentication) ligada.
CRM_API_URL=""
CRM_API_TOKEN=""
CRM_BYPASS_SECRET=""
